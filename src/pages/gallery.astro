---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { shuffle } from "utils";

const images = await Astro.glob<{ default: ImageMetadata }>(
    "../assets/**/*.{webp,jpg,heic}"
);
---


<h3 class="text-center font-bold text-4xl my-4 mx-2">WE DO SOME REALLY COOL THINGS HEHE &#128526;</h3>
<div class="flex w-full flex-wrap justify-center gap-4">
    {
        shuffle(images).map((file) => (
            <Image
                src={file.default}
                width={75}
                height={75}
                loading="lazy"
                alt="Gallery Image"
            />
        ))
    }
</div>
